<Window x:Class="TerminalGroupie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TerminalGroupie" Height="440" Width="600"
        MinHeight="260" MinWidth="440"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <Button x:Name="NewCmdBtn" Content="New (cmd)" Padding="8,4" Margin="2" />
            <Button x:Name="NewPsBtn" Content="New (PowerShell)" Padding="8,4" Margin="2" />
            <Separator />
            <Button x:Name="MinimizeTrayBtn" Content="Minimize to Tray" Padding="8,4" Margin="2" />
            <Button x:Name="KillAllBtn" Content="Kill All" Padding="8,4" Margin="2" />
            <Button x:Name="ExitBtn" Content="Exit" Padding="8,4" Margin="2" />
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="TerminalList" Grid.Column="0" Margin="8"
                      SelectionChanged="TerminalList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Terminal" Width="200" DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Header="Shell" Width="110" DisplayMemberBinding="{Binding Kind}" />
                        <GridViewColumn Header="State" Width="90" DisplayMemberBinding="{Binding StateText}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Column="1" Margin="8" VerticalAlignment="Top" Width="150">
                <TextBlock Text="Actions for selected terminal" Margin="0,0,0,8" TextWrapping="Wrap" />
                <Button x:Name="OpenBtn" Content="Open in window" Padding="8,6" Margin="0,0,0,6" IsEnabled="False" />
                <Button x:Name="HideBtn" Content="Minimize (hide)" Padding="8,6" Margin="0,0,0,6" IsEnabled="False" />
                <Button x:Name="KillBtn" Content="Kill terminal" Padding="8,6" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
