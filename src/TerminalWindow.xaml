<Window x:Class="TerminalGroupie.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Width="880" Height="540"
        MinWidth="420" MinHeight="260"
        Background="#FF1E1E1E"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <!-- Custom title bar: drag to move, buttons on the right. -->
        <Border DockPanel.Dock="Top" Height="36" Background="#FF2D2D30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" Text="Terminal"
                               Foreground="#FFE6E6E6" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="KindText" Text="cmd"
                               Margin="10,0,0,0" Foreground="#FFA0A0A0" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="TrayBtn"
                            Width="44" Height="36"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FFE6E6E6" FontSize="16" Content="—"
                            ToolTip="Minimize to tray (the shell keeps running)"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="TrayBtn_Click" />
                    <Button x:Name="KillBtn"
                            Width="44" Height="36"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FFE6E6E6" FontSize="15" Content="✕"
                            ToolTip="Close and kill the terminal"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="KillBtn_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The console window (a Win32 child HWND) is positioned over this area. -->
        <Grid x:Name="HostArea" Background="#FF1E1E1E" />
    </DockPanel>
</Window>
